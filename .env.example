# ── DeepSeek ──────────────────────────────────────────────────────────────
# آدرس چت دیپ‌سیک
DEEPSEEK_URL=https://chat.deepseek.com/

# user_data_dir ثابت برای playwright.chromium.launch_persistent_context
# پروفایل کرومیوم اکانت DeepSeek؛ کوکی‌ها و نشست لاگین اینجا ماندگار می‌شود.
# مسیر نسبی نسبت به ریشهٔ پروژه است.
DEEPSEEK_USER_DATA_DIR=./.deepseek_profile

# اولین اجرا false باشد تا پنجرهٔ مرورگر باز شود و دستی لاگین کنید؛
# بعداً می‌توانید true کنید (ولی در headless ورود دستی ممکن نیست).
# ترموکس: بدون termux-x11 اتصالِ پس‌زمینه خودکار headless می‌شود؛ برای ورود
# مرئی، termux-x11 را نصب/اجرا کن و export DISPLAY=:1 بزن. برای مرورگر روی
# ترموکس: pkg install chromium nodejs-lts (بقیهٔ تنظیم‌ها خودکار است).
DEEPSEEK_HEADLESS=false

# ── حلقهٔ ایجنت ──────────────────────────────────────────────────────────
# حداکثر دورِ ابزار در هر تسک (جلوگیری از حلقهٔ بی‌پایان)
MAX_ROUNDS=10
# حداکثر انتظار برای پاسخ دیپ‌سیک (ثانیه)
RESPONSE_TIMEOUT=240
RESPONSE_POLL_INTERVAL=2
RESPONSE_STABLE_CHECKS=3

# ── توکن گیت‌هاب ─────────────────────────────────────────────────────────
# ⚠️ توکن GitHub در این فایل نوشته نمی‌شود! با getpass هنگام اجرا از کاربر
# گرفته می‌شود و فقط در حافظه می‌ماند. این متغیر فقط برای تست‌های
# فقط‌خواندنی (tests/test_github_readonly.py) است:
#   GH_TOKEN=ghp_xxx python tests/test_github_readonly.py
# GH_TOKEN=

# تعداد تلاش مجاز برای وارد کردن توکن معتبر در شروع
TOKEN_MAX_ATTEMPTS=3

# ── محدودیت خروجی ابزارها ────────────────────────────────────────────────
# خروجی ابزارها قبل از ارسال به دیپ‌سیک کوتاه می‌شود (کاراکتر)
TOOL_RESULT_MAX_CHARS=20000

# ── DevX (رابط وب) ───────────────────────────────────────────────────────
# آدرس و پورت سرور محلی؛ اجرا: python devx.py
DEVX_HOST=127.0.0.1
DEVX_PORT=8770

# ── حافظهٔ ماندگار (Memory) ──────────────────────────────────────────────
# مسیر ذخیرهٔ حافظه؛ ایجنت «همه چیز را یادش می‌ماند»
MEMORY_DIR=./memory
MEMORY_MAX_FACTS=120
MEMORY_MAX_LESSONS=80
MEMORY_MAX_TASKS=80
# چند آیتم مرتبط ابتدای هر تسک به پرامپت تزریق شود
MEMORY_INJECT_FACTS=6
MEMORY_INJECT_LESSONS=4
MEMORY_INJECT_TASKS=3

# ── یادگیری مهارت (Skills) ───────────────────────────────────────────────
# مسیر کتابخانهٔ مهارت‌های آموخته‌شده
SKILLS_DIR=./skills_learned
# بعد از هر تسک موفق، یک مهارت قابل‌استفادهٔ مجدد استخراج و ذخیره شود؟
AUTO_LEARN_SKILL=true
# اگر خطای ابزار داشت، یک «درس» در حافظه ثبت شود؟
AUTO_LEARN_LESSON=true
# حداکثر مهارت‌های مرتبط تزریق‌شده در هر تسک
SKILLS_INJECT_LIMIT=3

# ────────────────────────────────────────────────────────────────────────────
# v4 — حافظهٔ هوشمند / امنیت / اتوماسیون
# ────────────────────────────────────────────────────────────────────────────
# جستجوی برداری سبک (TF-IDF + کسینوس) علاوه بر کلیدواژه‌ای
RAG_ENABLED=true
# فراموشی هوشمند: آیتم‌های بدون استفاده و کهنه → آرشیو
MEMORY_DECAY_ENABLED=true
MEMORY_DECAY_DAYS=30
# دروازهٔ تایید انسانی برای ابزارهای خطرناک
APPROVAL_REQUIRED=true
APPROVAL_TIMEOUT=180
APPROVAL_TTL=600
# سندباکس اجرای کد
SANDBOX_TIMEOUT=30
SANDBOX_MAX_OUTPUT=8000
# محدودسازی نرخ گیت‌هاب + بازتلاش
RATELIMIT_GH_PER_MIN=60
RETRY_MAX_ATTEMPTS=3
# سشن ماندگار گیت‌هاب: توکن در فایل محلی .gh_session.json (دسترسی ۶۰۰) ذخیره
# می‌شود تا بعد از ری‌استارت لاگین بماند؛ «خروج» از UI آن را کامل پاک می‌کند.
# false = رفتار قدیمی (فقط حافظهٔ همین اجرا، بعد از ری‌استارت ورود دوباره لازم است)
GH_SESSION_PERSIST=true
# ایجنت
REFLECTION_ENABLED=true
SUBAGENT_MAX_ROUNDS=6
CHECKPOINTS_ENABLED=true
# اتوماسیون
SCHEDULER_ENABLED=true
WATCHER_ENABLED=true
WATCH_INTERVAL_DEFAULT=300

# ── چرخش خودکار چت (Auto Chat Rollover) ────────────────────────────────────
# سقف context هر چت دیپ‌سیک (توکن). مصرف چت با «کاراکتر/۴» تخمین زده می‌شود؛
# اگر سایت عدد دقیق‌تری اعلام کرد فقط همین را تغییر بده.
DEEPSEEK_CONTEXT_TOKENS=1000000
# وقتی تخمین مصرف از این نسبتِ سقف گذشت، چت جدید ساخته و راهنمای پروژه منتقل می‌شود
ROLLOVER_AT_RATIO=0.85
ROLLOVER_ENABLED=true

# ── مغز API (جایگزین مرورگر — روی همه‌جا کار می‌کند، از جمله ترموکس) ────────
# اگر AI_API_KEY تنظیم شود، در اولویت است و مرورگر کرومیوم باز نمی‌شود.
# سازگار با هر سرویس OpenAI-Chat-Completions: DeepSeek رسمی، OpenRouter، z.ai، ...
# نمونهٔ دیپ‌سیک: کلید از platform.deepseek.com
#AI_API_KEY=
#AI_BASE_URL=https://api.deepseek.com
#AI_MODEL=deepseek-chat
#AI_TIMEOUT=240
